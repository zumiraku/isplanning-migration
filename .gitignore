# Never commit credentials or client secrets
*.secret
*credentials*
*password*
.env
.env.*

# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store
.vscode/
*.swp
~$*

# Large binaries we can always re-capture
snapshot/assets/**/*.zip
*.mp4

# Local scratch
tmp/
*.log

# The raw design ZIP is kept; its unpacked copy is not (templates/basic-export/design/
# holds the same files converted to UTF-8, which is what tools read).
templates/basic-export/design-backup/backup_original_design_*/
